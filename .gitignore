## A streamlined .gitignore for modern .NET projects

# -------------------------------------------------------------
# 1. BUILD RESULTS AND ARTIFACTS (Ваш поточний список)
# -------------------------------------------------------------

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
publish/
out/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/** 

# Others
~$*
*~
CodeCoverage/
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# -------------------------------------------------------------
# 2. VISUAL STUDIO & RIDER FILES
# -------------------------------------------------------------

# Visual Studio / VS Code
.vs/ 
*.suo
*.user
*.useros
*.sln.docstates 
vssver.scc
vssver2.scc

# Rider / ReSharper
**/.idea/
*.DotSettings.user # Локальні налаштування ReSharper/Rider
*.resharper 
*.bak 

# -------------------------------------------------------------
# 4. ENVIRONMENT & TEMPORARY FILES
# -------------------------------------------------------------
launchSettings.json

# Local database files
*.mdf
*.ldf
*.sdf

# Key secrets
**/appsettings.Development.json